{
  "name": "zotero-sapientia",
  "type": "module",
  "version": "0.1.4",
  "description": "Chat with your own ACP agent beside your Zotero library.",
  "config": {
    "addonName": "Zotero ACP Agent",
    "addonID": "zotero-sapientia@terenceliu98.github.io",
    "addonRef": "sapientia",
    "addonInstance": "Sapientia",
    "prefsPrefix": "extensions.zotero.sapientia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerenceLiu98/zotero-sapientia.git"
  },
  "author": "TerenceLiu98",
  "bugs": {
    "url": "https://github.com/TerenceLiu98/zotero-sapientia/issues"
  },
  "homepage": "https://github.com/TerenceLiu98/zotero-sapientia#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "test": "node scripts/test.mjs",
    "test:typecheck": "tsc --noEmit -p test/tsconfig.json",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.12.0",
    "lucide": "^1.80.0",
    "markdown-it": "^15.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "zotero-plugin-scaffold": "^0.9.4",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "6.0.3"
    }
  }
}
