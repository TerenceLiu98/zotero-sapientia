# Copy this file as `.env` and fill in the variables below.
# Every variable can also be set in the system environment.

# The Zotero binary.
# macOS: /Applications/Zotero.app/Contents/MacOS/zotero
# Windows: C:\Program Files\Zotero\zotero.exe
# Linux: /opt/zotero/zotero
ZOTERO_PLUGIN_ZOTERO_BIN_PATH =

# The profile `npm start` develops against. Create one with `zotero -p`:
# https://www.zotero.org/support/kb/profile_directory
ZOTERO_PLUGIN_PROFILE_PATH =

# The data directory that profile uses. Leave it empty only if that profile
# should use your default library (`~/Zotero`); `npm test` never needs it,
# because it always runs on a throwaway profile and library.
ZOTERO_PLUGIN_DATA_DIR =

# What stops Zotero at the end of `npm start`. The built-in command kills every
# process whose name contains "zotero", including a Zotero you have open.
# `npm test` ignores this and never runs that command.
# ZOTERO_PLUGIN_KILL_COMMAND =
